{
  "name": "nba-edge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port 5180 --host",
    "build": "vite build",
    "preview": "vite preview --port 4180",
    "pipeline": "tsx scripts/pipeline.ts",
    "settle": "tsx scripts/settle.ts",
    "lock-official-card": "tsx scripts/lock-official-card.ts",
    "render-games-text": "tsx scripts/render-games-text.ts",
    "pipeline:from-live": "tsx scripts/pipeline.ts --from-live",
    "odds-check": "tsx scripts/odds-check.ts",
    "typecheck": "tsc -p tsconfig.pipeline.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "screenshots:leg-sheet": "npm run build && tsx scripts/capture-leg-sheet-screenshots.ts",
    "screenshots:picks": "npm run build && tsx scripts/capture-picks-screenshots.ts",
    "screenshots:run44": "npm run build && tsx scripts/capture-run44-screenshots.ts",
    "screenshots:bookie-switch": "npm run build && tsx scripts/capture-bookie-switch-screenshots.ts",
    "test:watch": "vitest",
    "check:tracked-data": "bash scripts/check-tracked-data.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "html-to-image": "^1.11.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.49.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.6"
  }
}
